<?xml version="1.0" encoding="utf-8"?>
<!-- What streams ask for and how they show, the organization's gateway, and about the app. -->
<Page
    x:Class="Qdp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40" Spacing="4">
            <TextBlock Text="Settings" Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Video" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Resolution" />
                        <TextBlock Text="The size of the picture the computer sends. Smaller ones need less bandwidth." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ResolutionBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Resolution">
                        <x:String>Match the stream window</x:String>
                        <x:String>720p</x:String>
                        <x:String>1080p</x:String>
                        <x:String>1440p</x:String>
                        <x:String>4K</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE740;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Open streams full screen" />
                        <TextBlock Text="Ctrl+Alt+Shift+X switches between full screen and a window during a stream." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="FullScreenSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="OnToggled" AutomationProperties.Name="Open streams full screen" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE945;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Lowest latency" />
                        <TextBlock Text="Shows each picture as soon as it arrives, without waiting for the display. Displays without variable refresh may tear." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TearingSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="OnToggled" AutomationProperties.Name="Lowest latency" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Decoder" />
                        <TextBlock Text="Graphics cards that decode AV1 use the least power and add the least delay." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DecoderBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Decoder">
                        <x:String>Automatic</x:String>
                        <x:String>Graphics card only</x:String>
                        <x:String>Processor</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D2;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Show statistics over the stream" />
                        <TextBlock Text="Frame rate, latency and decoding time, in the stream's corner. Ctrl+Alt+Shift+S shows or hides them during a stream." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StatisticsSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="OnToggled" AutomationProperties.Name="Show statistics over the stream" />
                </Grid>
            </Border>

            <TextBlock Text="Audio" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE720;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Microphone on when a stream starts" />
                        <TextBlock Text="The computer hears this PC's microphone. Ctrl+Alt+Shift+M turns it on or off during a stream." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MicrophoneSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="OnToggled" AutomationProperties.Name="Microphone on when a stream starts" />
                </Grid>
            </Border>

            <TextBlock Text="Keyboard" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE765;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Send Windows shortcuts to the computer" />
                        <TextBlock Text="The Windows key, Alt+Tab, Alt+F4 and others act on the computer you stream instead of this PC." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ShortcutsBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Send Windows shortcuts to the computer">
                        <x:String>In full screen</x:String>
                        <x:String>Always</x:String>
                        <x:String>Never</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77F;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Share the clipboard" />
                        <TextBlock Text="Text and images you copy on either side can be pasted on the other." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ClipboardSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="OnToggled" AutomationProperties.Name="Share the clipboard" />
                </Grid>
            </Border>

            <TextBlock Text="During a stream" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ctrl+Alt+Shift+Z" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="Release the mouse and the keys held" />
                    <TextBlock Grid.Row="1" Text="Ctrl+Alt+Shift+X" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Switch between full screen and a window" />
                    <TextBlock Grid.Row="2" Text="Ctrl+Alt+Shift+M" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Turn the microphone on or off" />
                    <TextBlock Grid.Row="3" Text="Ctrl+Alt+Shift+S" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Show or hide the statistics" />
                    <TextBlock Grid.Row="4" Text="Ctrl+Alt+Shift+Q" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Disconnect" />
                </Grid>
            </Border>

            <TextBlock Text="Your organization" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE821;" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gateway" />
                        <TextBlock Text="Reach your organization's computers from anywhere, signing in with your work account. Your administrator gives you the gateway's address; computers you add then go through it." Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <TextBox x:Name="GatewayAddressBox" Grid.Row="1" Grid.Column="1" Header="Gateway address" PlaceholderText="gateway.example.com" TextChanged="OnGatewayChanged" />
                    <TextBox x:Name="GatewayUserBox" Grid.Row="2" Grid.Column="1" Header="User name" PlaceholderText="Optional: your name in your organization's directory" TextChanged="OnGatewayChanged" />
                    <TextBox x:Name="GatewayPinBox" Grid.Row="3" Grid.Column="1" Header="Gateway key pin" PlaceholderText="Optional: only if your administrator gave you one" FontFamily="Consolas" TextChanged="OnGatewayChanged" />
                    <TextBlock x:Name="GatewayPinError" Grid.Row="4" Grid.Column="1" Text="A key pin is 64 hexadecimal digits. Until it is one, the gateway is not changed." TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/qdp.png" Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="QDP" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open the log folder" VerticalAlignment="Center" Click="OnOpenLogsClicked" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D7;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="This PC's key pin" />
                        <TextBlock Text="A host's owner can add it with qdp clients add, instead of pairing." Style="{StaticResource DescriptionStyle}" />
                        <TextBlock x:Name="PinText" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button x:Name="CopyPinButton" Grid.Column="2" VerticalAlignment="Center" Click="OnCopyPinClicked" AutomationProperties.Name="Copy the key pin">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
