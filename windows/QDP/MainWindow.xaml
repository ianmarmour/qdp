<?xml version="1.0" encoding="utf-8"?>
<!--
    The main window: computers to stream and settings, in a navigation view
    on Mica, under a title bar of the app's own; and, while a stream starts
    or runs, a card over them that says how it goes.
-->
<Window
    x:Class="Qdp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quick Desktop">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/qdp.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="Quick Desktop"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HostsItem" Content="Computers" Tag="hosts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Grid
            x:Name="StreamOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Border
                MaxWidth="460"
                Margin="24"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="16">
                    <ProgressRing x:Name="StreamProgress" Width="40" Height="40" IsActive="True" />
                    <FontIcon
                        x:Name="StreamIcon"
                        Glyph="&#xE7F4;"
                        FontSize="40"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="StreamTitle"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="StreamStatus"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />

                    <Grid x:Name="StatsPanel" Visibility="Collapsed" ColumnSpacing="32" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="FrameRateText" Text="–" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Frames a second" HorizontalAlignment="Center" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="LatencyText" Text="–" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Latency" HorizontalAlignment="Center" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="DecodeText" Text="–" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Decoding" HorizontalAlignment="Center" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed" Spacing="4">
                        <TextBlock Text="In the stream, hold Ctrl+Alt+Shift and press" HorizontalAlignment="Center" Style="{StaticResource DescriptionStyle}" />
                        <TextBlock
                            Text="Z to release the mouse · X for full screen · S for statistics · M for the microphone · Q to disconnect"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="ShowStreamButton" Content="Show the stream" Visibility="Collapsed" Click="OnShowStreamClicked" />
                        <Button x:Name="StopButton" Content="Cancel" Click="OnStopClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
