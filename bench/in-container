#!/bin/bash
# Runs inside the benchmark container: builds QDP and qdp-bench from the
# checkout in /src, then measures each protocol over each network profile
# and with each scene, in an order that rotates each round, between a
# host's and a client's headless GNOME sessions, at each refresh rate.
# Results and a report go to /results.
set -euo pipefail

size=${QDP_BENCH_SIZE:-1920x1080}
seconds=${QDP_BENCH_SECONDS:-15}
rounds=${QDP_BENCH_ROUNDS:-1}
read -ra protocols <<< "${QDP_BENCH_PROTOCOLS:-local qdp sunshine rdp vnc}"
read -ra profiles <<< "${QDP_BENCH_PROFILES:-lan wan}"
read -ra refreshes <<< "${QDP_BENCH_REFRESH:-60 120}"
read -ra scenes <<< "${QDP_BENCH_SCENES:-low scroll full}"

results=/results
logs=$results/logs
runs=$results/runs
state=/run/bench
mkdir -p "$logs" "$runs"

# The credentials the RDP and VNC viewers sign in with; VNC's passwords
# have at most eight characters.
user=bench
password=benchpas

# An interruption, from Ctrl+C or the container stopping, stops everything
# started at once. Bash runs the trap only between commands, so the long
# ones run in the background and are waited for.
trap 'trap - INT TERM; kill 0' INT TERM

cd /src
cargo build --release --locked -p qdp-cli -p qdp-bench &
wait $!
bin=$CARGO_TARGET_DIR/release

# The X11 display of the client's session, once it has one.
client_x11=""

# Prints the environment of session $1: a GNOME Wayland session's, which the
# desktop portal serves only when it says so. Its pointer has GNOME's
# cursors, as a desktop's does: a host takes a pointer kept hidden over an
# application for one the application captured, as a game's.
session_env() {
    echo "HOME=$state/$1 XDG_RUNTIME_DIR=$state/$1" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=$state/$1/bus WAYLAND_DISPLAY=wayland-0" \
        "XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome XDG_SESSION_TYPE=wayland" \
        "XCURSOR_THEME=Adwaita XCURSOR_SIZE=24"
    if [ "$1" = client ]; then
        echo "$client_x11"
    fi
}

# Runs a command in session $1.
in_session() {
    local name=$1
    shift
    # shellcheck disable=SC2046 # The environment splits into its variables.
    env $(session_env "$name") "$@"
}

# Starts a command in session $1, logging to $2, and sets $pid to its
# process ID.
spawn() {
    local name=$1 log=$2
    shift 2
    # shellcheck disable=SC2046
    env $(session_env "$name") "$@" &> "$log" &
    pid=$!
}

# Stops the processes whose IDs are given, if any: waiting for none would
# wait for every process started.
stop() {
    if [ "$#" = 0 ]; then
        return 0
    fi
    kill "$@" 2> /dev/null || true
    wait "$@" 2> /dev/null || true
}

# Waits up to 30 seconds for the command given to succeed.
wait_for() {
    for _ in $(seq 300); do
        if "$@" > /dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    echo "timed out waiting for: $*" >&2
    return 1
}

# The processes of each running session.
declare -A session_pids

# Starts headless GNOME session $1, afresh: its own D-Bus session bus,
# PipeWire, WirePlumber and Mutter. With $2 "monitor", Mutter has a virtual
# monitor of the benchmark's size, refreshing at the rate measured; with
# "none", it has none until a remote desktop server makes one. With $3
# "x11", X11 applications run in it too.
start_session() {
    local name=$1 monitor=$2 x11=$3
    local mutter=(mutter --headless --wayland)
    if [ "$monitor" = monitor ]; then
        mutter+=(--virtual-monitor "$size@$refresh")
    fi
    if [ "$x11" != x11 ]; then
        mutter+=(--no-x11)
    fi
    rm -rf "${state:?}/$name"
    mkdir -p -m 700 "$state/$name"
    local log=$logs/$name
    spawn "$name" "$log-dbus.log" \
        dbus-daemon --session --nofork --address="unix:path=$state/$name/bus"
    local pids=("$pid")
    wait_for test -S "$state/$name/bus"
    spawn "$name" "$log-pipewire.log" pipewire
    pids+=("$pid")
    wait_for test -S "$state/$name/pipewire-0"
    spawn "$name" "$log-wireplumber.log" wireplumber
    pids+=("$pid")
    spawn "$name" "$log-mutter.log" "${mutter[@]}"
    pids+=("$pid")
    session_pids[$name]="${pids[*]}"
    wait_for in_session "$name" gdbus introspect --session \
        --dest org.gnome.Mutter.ScreenCast --object-path /org/gnome/Mutter/ScreenCast
    if [ "$x11" = x11 ]; then
        wait_for compgen -G "$state/$name/.mutter-Xwaylandauth.*"
        local authority
        authority=$(compgen -G "$state/$name/.mutter-Xwaylandauth.*" | head -1)
        client_x11="DISPLAY=:0 XAUTHORITY=$authority"
    fi
}

# Stops session $1.
stop_session() {
    # shellcheck disable=SC2086 # The IDs split into words.
    stop ${session_pids[$1]}
}

# Returns whether session $1 has a monitor.
has_monitor() {
    in_session "$1" gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.gnome.Mutter.DisplayConfig.GetCurrentState | grep -q "'Meta-"
}

# Sets the network that the host and the client talk over to profile $1:
# its delay applies each way.
apply_profile() {
    tc qdisc del dev lo root 2> /dev/null || true
    local netem
    case $1 in
        lan) return 0 ;;
        wan) netem=(delay 15ms) ;;
        lossy) netem=(delay 15ms loss 1%) ;;
        *)
            echo "unknown network profile $1" >&2
            return 1
            ;;
    esac
    if ! tc qdisc add dev lo root netem "${netem[@]}"; then
        echo "the $1 profile needs the sch_netem kernel module: sudo modprobe sch_netem" >&2
        return 1
    fi
}

# Starts GNOME's remote desktop server in the host's session, serving
# protocol $1, rdp or vnc, and sets $pid to it. Headless, it gives each
# client a monitor of its own.
start_gnome_remote_desktop() {
    local kind=$1
    if [ "$kind" = rdp ]; then
        local tls=$state/host/tls
        mkdir -p "$tls"
        openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=bench \
            -keyout "$tls/key.pem" -out "$tls/cert.pem" &> /dev/null
        in_session host grdctl --headless rdp set-tls-cert "$tls/cert.pem" &> /dev/null
        in_session host grdctl --headless rdp set-tls-key "$tls/key.pem" &> /dev/null
        in_session host grdctl --headless rdp set-credentials "$user" "$password" &> /dev/null
    else
        in_session host grdctl --headless vnc set-auth-method password &> /dev/null
        in_session host grdctl --headless vnc set-password "$password" &> /dev/null
    fi
    in_session host gsettings set "org.gnome.desktop.remote-desktop.$kind" view-only false
    in_session host gsettings set "org.gnome.desktop.remote-desktop.$kind.headless" \
        negotiate-port false
    in_session host gsettings set "org.gnome.desktop.remote-desktop.$kind.headless" enable true
    local port=3389
    if [ "$kind" = vnc ]; then
        port=5900
    fi
    spawn host "$log-server.log" /usr/lib/gnome-remote-desktop-daemon --headless
    local server=$pid
    wait_for bash -c "ss -ltn | grep -q ':$port '"
    pid=$server
}

# The restore token Sunshine shows the desktop portal, which lets it share
# the screen without asking, once start_sunshine stores the approval.
sunshine_token=00000000-0000-4000-8000-000000000001

# The monitor the approval names, as GNOME's portal matches it: the
# headless session's virtual monitor.
sunshine_monitor=MetaVendor:MetaVirtualMonitor:0x00

# Starts Sunshine in the host's session, sharing its screen through the
# desktop portal, and sets $pid to it. The portal asks the user to approve
# a new request, and no one is there to, so the approval it keeps for a
# remembered one is stored first: for any application, for the keyboard
# and pointer, and for the monitor.
start_sunshine() {
    in_session host gdbus call --session --dest org.freedesktop.impl.portal.PermissionStore \
        --object-path /org/freedesktop/impl/portal/PermissionStore \
        --method org.freedesktop.impl.portal.PermissionStore.Set \
        remote-desktop true "$sunshine_token" "{'': ['yes']}" \
        "<('GNOME', uint32 1, <(int64 0, int64 0, uint32 3, false,
            [(uint32 0, uint32 1, <'$sunshine_monitor'>)])>)>" > /dev/null
    local config=$state/host/.config/sunshine
    mkdir -p "$config"
    printf '%s' "$sunshine_token" > "$config/portal_token.gnome"
    printf '%s\n' 'capture = portal' 'system_tray = disabled' > "$config/sunshine.conf"
    in_session host sunshine --creds "$user" "$password" &> /dev/null
    spawn host "$log-server.log" sunshine
    # Its web interface, which pairing goes through, comes up first, and
    # the server Moonlight pairs with once Sunshine has found an encoder.
    wait_for sunshine_api apps && wait_for bash -c "ss -ltn | grep -q ':47989 '"
}

# Starts Sunshine, and Moonlight streaming from it full screen on the
# client's screen, and sets $server and $viewer to them. Sunshine asks the
# desktop portal for the screen many times as it starts, and again as a
# stream does, and listens for each answer only once it has asked: now and
# then, mostly on a busy machine, the answer comes first and is missed, and
# Sunshine waits on the portal for good. So it is started again, up to
# three times.
start_sunshine_stream() {
    for _ in 1 2 3; do
        local started=0
        start_sunshine || started=1
        server=$pid
        if [ "$started" = 0 ] && pair_moonlight && start_moonlight; then
            return 0
        fi
        stop "$server"
    done
    return 1
}

# Starts Moonlight streaming Sunshine's desktop full screen in the client's
# session, sets $viewer to it, and waits for the stream's first picture.
start_moonlight() {
    spawn client "$log-viewer.log" moonlight stream 127.0.0.1 Desktop \
        --resolution "$size" --fps "$refresh" --display-mode fullscreen --absolute-mouse
    viewer=$pid
    if wait_for grep -q "Received first video packet" "$log-viewer.log"; then
        return 0
    fi
    stop "$viewer"
    return 1
}

# Calls Sunshine's web interface at path $1 under /api, signed in, with the
# options to curl after it.
sunshine_api() {
    local path=$1
    shift
    curl -sfk -u "$user:$password" "$@" "https://127.0.0.1:47990/api/$path"
}

# Returns whether Sunshine's web interface at path $1 lists $2.
sunshine_lists() {
    sunshine_api "$1" | grep -q "$2"
}

# Pairs Moonlight in the client's session with Sunshine. Now and then
# Moonlight says the PIN was wrong when it was not, as it can for a user,
# and pairing is tried again.
pair_moonlight() {
    if sunshine_lists clients/list '"uuid"'; then
        return 0
    fi
    for _ in 1 2 3; do
        if try_pairing; then
            return 0
        fi
    done
    return 1
}

# Tries pairing Moonlight with Sunshine once, entering the PIN Moonlight
# pairs with in Sunshine's web interface, as a user would.
try_pairing() {
    local pin=1234 paired=1
    rm -rf "$state/client/.config/Moonlight Game Streaming Project"
    spawn client "$log-pair.log" moonlight pair 127.0.0.1 --pin "$pin"
    local pairing=$pid
    if wait_for sunshine_lists pin '"id"'; then
        local id
        id=$(sunshine_api pin | grep -o '"id":"[0-9a-f]*"' | head -1 | cut -d'"' -f4)
        sunshine_api pin -X POST -H 'Content-Type: application/json' \
            -d "{\"pairing_id\":\"$id\",\"pin\":\"$pin\",\"name\":\"bench\"}" > /dev/null
        # Moonlight says it paired until someone closes it, so Sunshine's
        # list of paired clients says when it has.
        if wait_for sunshine_lists clients/list '"uuid"'; then
            paired=0
        fi
    fi
    stop "$pairing"
    return "$paired"
}

# Starts what protocol $1 needs: a host's session, the protocol's server
# there, and its viewer full screen on the client's screen, which stay up
# while the probe shows each scene over each network profile. Sets
# $processes to the server and the viewer, as the measurer's options, and
# $pids to every process to stop afterwards. The local baseline needs
# neither: the probe goes on the client's own screen.
start_protocol() {
    log=$logs/$refresh-$1-$round
    local server viewer
    case $1 in
        local)
            processes=() pids=()
            return 0
            ;;
        qdp)
            start_session host monitor no-x11
            # The host streams as many frames a second as the screens
            # refresh, rather than its default 60.
            spawn host "$log-server.log" "$bin/qdp" serve --source gnome --token bench \
                --listen 127.0.0.1:4433 --identity "$state/host/qdp" \
                --advertise off --pairing off --fps "$refresh"
            server=$pid
            wait_for grep -q 'pin="' "$log-server.log"
            local pin
            pin=$(grep -o 'pin="[0-9a-f]*"' "$log-server.log" | head -1 | cut -d'"' -f2)
            QDP_TOKEN=bench spawn client "$log-viewer.log" "$bin/qdp" connect 127.0.0.1:4433 \
                --pin "$pin" --full-screen --identity "$state/client/qdp"
            viewer=$pid
            ;;
        sunshine)
            start_session host monitor no-x11
            start_sunshine_stream || return 1
            ;;
        rdp | vnc)
            # The server's monitor appears once the viewer connects, and
            # the probe goes on it.
            start_session host none no-x11
            start_gnome_remote_desktop "$1"
            server=$pid
            # FreeRDP's Wayland viewer, full screen; its SDL viewer leaves
            # its window's input unread here. TigerVNC's viewer runs through
            # Xwayland in a window: full screen, it never shows. The
            # measurer finds the probe in either. Neither shares the
            # clipboard, as GNOME's RDP server would need FUSE for it.
            if [ "$1" = rdp ]; then
                spawn client "$log-viewer.log" wlfreerdp3 /v:127.0.0.1 \
                    "/u:$user" "/p:$password" /cert:ignore /f -clipboard
            else
                vncpasswd -f <<< "$password" > "$state/client/vncpasswd"
                spawn client "$log-viewer.log" vncviewer \
                    -PasswordFile "$state/client/vncpasswd" 127.0.0.1::5900
            fi
            viewer=$pid
            wait_for has_monitor host
            ;;
        *)
            echo "unknown protocol $1" >&2
            return 1
            ;;
    esac
    processes=(--process "server=$server" --process "viewer=$viewer")
    pids=("$viewer" "$server")
}

# The highest refresh rate GNOME Remote Desktop streams at, in hertz: RDP
# at 60 frames a second, VNC at 30. Above it, only QDP and the baseline are
# measured.
remote_desktop_max_refresh=60

# Returns whether protocol $1 is measured at $refresh.
measured_at_refresh() {
    case $1 in
        rdp | vnc) [ "$refresh" -le "$remote_desktop_max_refresh" ] ;;
        *) return 0 ;;
    esac
}

# Starts the probe showing $scene where protocol $1 shows it: on the
# host's screen, or for the local baseline, the client's. Sets $probe to
# it.
start_probe() {
    local session=host
    if [ "$1" = local ]; then
        session=client
    fi
    spawn "$session" "$logs/$run-probe.log" "$bin/qdp-bench" probe --scene "$scene"
    probe=$pid
}

# Stops what protocol $1 started.
stop_protocol() {
    stop "${pids[@]}"
    if [ "$1" != local ]; then
        stop_session host
    fi
}

for refresh in "${refreshes[@]}"; do
    start_session client monitor x11
    for round in $(seq "$rounds"); do
        # Each round starts one protocol later, so that none always runs
        # first or last.
        count=${#protocols[@]}
        for index in $(seq 0 $((count - 1))); do
            protocol=${protocols[$(((index + round - 1) % count))]}
            if ! measured_at_refresh "$protocol"; then
                continue
            fi
            if ! start_protocol "$protocol"; then
                echo "starting $protocol failed; see $logs" >&2
                stop_protocol "$protocol"
                continue
            fi
            for profile in "${profiles[@]}"; do
                if ! apply_profile "$profile"; then
                    echo "skipping the $profile profile" >&2
                    continue
                fi
                for scene in "${scenes[@]}"; do
                    echo "$refresh Hz, round $round, $profile, $scene: $protocol"
                    run=$refresh-$scene-$profile-$protocol-$round
                    start_probe "$protocol"
                    measured=0
                    in_session client "$bin/qdp-bench" measure \
                        --protocol "$protocol" --profile "$profile" --scene "$scene" \
                        --round "$round" --refresh "$refresh" --seconds "$seconds" \
                        "${processes[@]}" --out "$runs/$run.toml" \
                        &> "$logs/$run-measure.log" &
                    wait $! || measured=$?
                    stop "$probe"
                    if [ "$measured" != 0 ]; then
                        echo "measuring $protocol over $profile failed; see $logs" >&2
                    fi
                done
            done
            apply_profile lan
            stop_protocol "$protocol"
        done
    done
    stop_session client
done
apply_profile lan

{
    "$bin/qdp-bench" report "$runs"
    echo
    echo "## Environment"
    echo
    echo "- Commit: $(cat "$results/commit" 2> /dev/null || echo unknown)"
    echo "- Kernel: $(uname -r)"
    echo "- CPU: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
    echo "- GPU: $(cat /sys/class/drm/renderD*/device/uevent 2> /dev/null \
        | grep -m1 PCI_ID | cut -d= -f2 || echo none)"
    echo "- QDP's encoder: $(grep -ho 'encoder="[^"]*"' "$logs"/*-qdp-*-server.log 2> /dev/null \
        | head -1 | cut -d'"' -f2 || echo unknown)"
    echo "- QDP's decoder: $(grep -ho 'decoder="[^"]*"' "$logs"/*-qdp-*-viewer.log 2> /dev/null \
        | head -1 | cut -d'"' -f2 || echo unknown)"
    rounds_measured="$rounds rounds"
    if [ "$rounds" = 1 ]; then
        rounds_measured="1 round"
    fi
    echo "- Screen: $size at $(echo "${refreshes[*]}" | sed 's/ /, /g') Hz," \
        "$seconds seconds a run, $rounds_measured"
    echo "- Packages: $(pacman -Q mutter gnome-remote-desktop freerdp tigervnc sunshine \
        moonlight-qt mesa \
        | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
} > "$results/report.md"
cat "$results/report.md"
