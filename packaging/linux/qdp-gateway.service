# The QDP gateway as a system service: it signs users in with the
# organization's directory and TOTP, and tunnels their sessions to the hosts
# they may reach. Configure /etc/qdp-gateway/gateway.toml, then turn it on
# with `systemctl enable --now qdp-gateway`, or with
# `qdp-gateway service install`, which writes its own copy.
[Unit]
Description=QDP gateway
Documentation=https://github.com/ianmarmour/qdp/blob/main/doc/spec/13-gateway.md
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/qdp-gateway serve --config /etc/qdp-gateway/gateway.toml
User=qdp-gateway
Group=qdp-gateway
# Its TLS and assertion keys and the users' TOTP secrets.
StateDirectory=qdp-gateway
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# It listens on UDP port 443 without being root, and may change nothing of
# the system but its state. What it keeps is the network and that port,
# which it serves on: `systemd-analyze security` rates it 1.4 of 10,
# where lower is safer.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
