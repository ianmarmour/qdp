#!/bin/sh
# Before the QDP gateway is removed, not upgraded: the service stops and is
# turned off.
set -e

if [ "$1" = remove ]; then
  systemctl --no-reload disable qdp-gateway.service >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl stop qdp-gateway.service >/dev/null 2>&1 || true
  fi
fi

exit 0
