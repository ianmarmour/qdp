# pacman's install script for the QDP gateway. pacman's own hooks reload
# systemd at the end of each transaction, and a new service is off, since
# its configuration is to be written first.

# The gateway's user exists now, rather than at the transaction's end, so
# that its configuration is readable by that user's group alone.
post_install() {
  systemd-sysusers /usr/lib/sysusers.d/qdp-gateway.conf >/dev/null 2>&1 || true
  chgrp qdp-gateway /etc/qdp-gateway/gateway.toml 2>/dev/null || true
}

# Upgrading restarts a running service with the new program.
post_upgrade() {
  post_install
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart qdp-gateway.service >/dev/null 2>&1 || true
  fi
}

# Removing the gateway stops its service and turns it off.
pre_remove() {
  systemctl --no-reload disable --now qdp-gateway.service >/dev/null 2>&1 || true
}
